{
  "stages": [
    {
      "monitor": [
        {"type": "visual_state", "observe": "the rabbit gallbladder mucosal surface has been washed"},
        {"type": "resource_ready", "prepare": "0.125% type IV collagenase solution, culture dish"}
      ],
      "subtasks": [
        {"action": "transfer", "object": "the washed rabbit gallbladder, mucosal side facing down", "source": "workspace", "target": "culture dish"},
        {"action": "aspirate", "object": "0.125% type IV collagenase solution", "amount": "2mL"},
        {"action": "dispense", "place": "culture dish", "amount": "2mL"},
        {"action": "put_into_incubator", "object": "culture dish"},
        {"action": "set_incubator", "temp": "37℃", "CO2": "5%"},
        {"action": "start_device", "device": "incubator"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "device": "incubator", "time": "15min"},
        {"type": "resource_ready", "prepare": "DMEM/F12 medium containing 10% fetal bovine serum, centrifuge tube"}
      ],
      "subtasks": [
        {"action": "take_out_incubator", "object": "culture dish"},
        {"action": "aspirate", "object": "DMEM/F12 medium containing 10% fetal bovine serum", "amount": "2mL"},
        {"action": "dispense", "place": "culture dish", "amount": "2mL"},
        {"action": "transfer_liquid", "source": "culture dish", "target": "centrifuge tube"},
        {"action": "put_into_centrifuge", "object": "centrifuge tube"},
        {"action": "set_centrifuge", "speed": "1000r/min", "time": "5min"},
        {"action": "start_device", "device": "centrifuge"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "time": "5min", "device": "centrifuge"}
      ],
      "subtasks": [
        {"action": "take_out_centrifuge", "object": "centrifuge tube"},
        {"action": "discard_supernatant", "object": "centrifuge tube"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "supernatant removed"},
        {"type": "resource_ready", "prepare": "trypan blue solution, hemocytometer, empty tube"}
      ],
      "subtasks": [
        {"action": "count_cells_trypan_blue", "source": "centrifuge tube"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "the cell counting results have been obtained, and the required volume of medium to be added (V mL) has been calculated based on the target concentration"},
        {"type": "resource_ready", "prepare": "DMEM/F12 medium containing 10% fetal bovine serum, culture flask"}
      ],
      "subtasks": [
        {"action": "cell_dilution", "target": "centrifuge tube", "diluent": "DMEM/F12 medium containing 10% fetal bovine serum", "density": "5×10^4 cell/mL"},
        {"action": "cell_seed", "source": "centrifuge tube", "plate": "culture flask", "volume": "2mL"},
        {"action": "put_into_incubator", "object": "culture flask"},
        {"action": "set_incubator", "CO2": "5%", "temp": "37℃"},
        {"action": "start_device", "device": "incubator"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "device": "incubator", "time": "3d"},
        {"type": "resource_ready", "prepare": "DMEM/F12 medium containing 10% fetal bovine serum"}
      ],
      "subtasks": [
        {"action": "take_out_incubator", "object": "culture flask"},
        {"action": "discard_medium", "object": "culture flask"},
        {"action": "aspirate", "object": "DMEM/F12 medium containing 10% fetal bovine serum", "amount": "2mL"},
        {"action": "dispense", "place": "culture flask", "amount": "2mL"},
        {"action": "put_into_incubator", "object": "culture flask"},
        {"action": "set_incubator", "CO2": "5%", "temp": "37℃"},
        {"action": "start_device", "device": "incubator"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "device": "incubator", "time": "2d"}
      ],
      "subtasks": [
        {"action": "take_out_incubator", "object": "culture flask"}
      ]
    }
  ]
}