{
  "stages": [
    {
      "monitor": [
        {"type": "resource_ready", "prepare": "paste-like mouse mammary gland tissue (approximately 5 g), triangular flask, collagenase solution, thermostatic shaker"}
      ],
      "subtasks": [
        {"action": "transfer", "object": "cut mammary gland tissue", "source": "workspace", "target": "triangular flask"},
        {"action": "aspirate", "object": "collagenase solution", "amount": "25mL"},
        {"action": "dispense", "place": "triangular flask", "amount": "25mL"},
        {"action": "put_into_device", "device": "thermostatic shaker", "object": "triangular flask"},
        {"action": "set_device", "device": "thermostatic shaker","temp": "37℃", "speed": "200r/min", "time": "1h"},
        {"action": "start_device", "device": "thermostatic shaker"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "device": "thermostatic shaker", "time": "1h"},
        {"type": "resource_ready", "prepare": "centrifuge tube"}
      ],
      "subtasks": [
        {"action": "take_out_device","device": "thermostatic shaker", "object": "triangular flask"},
        {"action": "transfer_liquid", "source": "triangular flask", "target": "centrifuge tube"},
        {"action": "put_into_centrifuge", "object": "centrifuge tube"},
        {"action": "set_centrifuge", "speed": "800r/min", "time": "4min"},
        {"action": "start_device", "device": "centrifuge"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "time": "4min", "device": "centrifuge"}
      ],
      "subtasks": [
        {"action": "take_out_centrifuge", "object": "centrifuge tube"},
        {"action": "discard_supernatant", "object": "centrifuge tube"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "supernatant removed"},
        {"type": "resource_ready", "prepare": "F12 medium"}
      ],
      "subtasks": [
        {"action": "aspirate", "object": "F12 medium", "amount": "2mL"},
        {"action": "dispense", "place": "centrifuge tube", "amount": "2mL"},
        {"action": "resuspension", "object": "centrifuge tube"},
        {"action": "repeat", "back": "put_into_centrifuge", "count": "2"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "cell suspension in centrifuge tube washed by centrifugation three times"},
        {"type": "resource_ready", "prepare": "trypan blue solution, hemocytometer, empty tube"}
      ],
      "subtasks": [
        {"action": "count_cells_trypan_blue", "source": "centrifuge tube"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "the cell counting results have been obtained, and the required volume of medium to be added (V mL) has been calculated based on the target density"},
        {"type": "resource_ready", "prepare": "2× seeding medium, serum-coated culture dish"}
      ],
      "subtasks": [
        {"action": "cell_dilution", "target": "centrifuge tube", "diluent": "2× seeding medium", "density": "5×10^5 cell/mL"},
        {"action": "cell_seed", "source": "centrifuge tube", "plate": "serum-coated culture dish", "volume": "2mL"},
        {"action": "put_into_incubator", "object": "culture dish"},
        {"action": "set_incubator", "CO2": "5%", "temp": "37℃"},
        {"action": "start_device", "device": "incubator"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "device": "incubator", "time": "48h"},
        {"type": "resource_ready", "prepare": "growth medium"}
      ],
      "subtasks": [
        {"action": "take_out_incubator", "object": "culture dish"},
        {"action": "discard_medium", "object": "culture dish"},
        {"action": "aspirate", "object": "growth medium", "amount": "2mL"},
        {"action": "dispense", "place": "culture dish", "amount": "2mL"},
        {"action": "put_into_incubator", "object": "culture dish"},
        {"action": "set_incubator", "CO2": "5%", "temp": "37℃"},
        {"action": "start_device", "device": "incubator"}
      ]
    }
  ]
}