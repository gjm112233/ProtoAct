{
  "stages": [
    {
      "monitor": [
        {"type": "resource_ready", "prepare": "minced mouse prostate tissue (approximately 3 g), 25 cm² culture flask, collagenase solution"}
      ],
      "subtasks": [
        {"action": "transfer", "object": "minced mouse prostate tissue", "source": "workspace", "target": "25 cm² culture flask"},
        {"action": "aspirate", "object": "collagenase solution", "amount": "30mL"},
        {"action": "dispense", "place": "culture flask", "amount": "30mL"},
        {"action": "put_into_device", "device": "shaking water bath", "object": "culture flask"},
        {"action": "set_device", "device": "shaking water bath", "temp": "37℃", "time": "1h"},
        {"action": "start_device", "device": "shaking water bath"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "device": "shaking water bath", "time": "1h"},
        {"type": "resource_ready", "prepare": "centrifuge tube"}
      ],
      "subtasks": [
        {"action": "take_out_device","device": "shaking water bath", "object": "culture flask"},
        {"action": "transfer_liquid", "source": "culture flask", "target": "centrifuge tube"},
        {"action": "put_into_centrifuge", "object": "centrifuge tube"},
        {"action": "set_centrifuge", "force": "100g", "time": "5min"},
        {"action": "start_device", "device": "centrifuge"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "time": "5min", "device": "centrifuge"}
      ],
      "subtasks": [
        {"action": "take_out_centrifuge", "object": "centrifuge tube"},
        {"action": "discard_supernatant", "object": "centrifuge tube"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "supernatant removed"},
        {"type": "resource_ready", "prepare": "MSS containing 5% serum"}
      ],
      "subtasks": [
        {"action": "aspirate", "object": "MSS containing 5% serum", "amount": "5mL"},
        {"action": "dispense", "place": "centrifuge tube", "amount": "5mL"},
        {"action": "resuspension", "object": "centrifuge tube"}
      ]
    },

    {
      "monitor": [
        {"type": "resource_ready", "prepare": "253μm nylon screen, empty centrifuge tube"}
      ],
      "subtasks": [
        {"action": "filter_cell_suspension", "source": "centrifuge tube containing cell suspension", "filter_tool": "253μm nylon screen", "target": "empty centrifuge tube"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "cell suspension from old centrifuge tube filtered"},
        {"type": "resource_ready", "prepare": "MSS containing 5% serum"}
      ],
      "subtasks": [
        {"action": "aspirate", "object": "MSS containing 5% serum", "amount": "5mL"},
        {"action": "dispense", "place": "the inner surface of the 253μm nylon screen", "amount": "5mL"}
      ]
    },

    {
      "monitor": [
        {"type": "resource_ready", "prepare": "150μm nylon screen, empty centrifuge tube"}
      ],
      "subtasks": [
        {"action": "filter_cell_suspension", "source": "centrifuge tube containing cell suspension", "filter_tool": "150μm nylon screen", "target": "empty centrifuge tube"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "cell suspension from old centrifuge tube filtered"},
        {"type": "resource_ready", "prepare": "MSS containing 5% serum"}
      ],
      "subtasks": [
        {"action": "aspirate", "object": "MSS containing 5% serum", "amount": "5mL"},
        {"action": "dispense", "place": "the inner surface of the 150μm nylon screen", "amount": "5mL"}
      ]
    },

    {
      "monitor": [
        {"type": "resource_ready", "prepare": "100μm nylon screen, empty centrifuge tube"}
      ],
      "subtasks": [
        {"action": "filter_cell_suspension", "source": "centrifuge tube containing cell suspension", "filter_tool": "100μm nylon screen", "target": "empty centrifuge tube"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "cell suspension from old centrifuge tube filtered"},
        {"type": "resource_ready", "prepare": "MSS containing 5% serum"}
      ],
      "subtasks": [
        {"action": "aspirate", "object": "MSS containing 5% serum", "amount": "5mL"},
        {"action": "dispense", "place": "the inner surface of the 100μm nylon screen", "amount": "5mL"}
      ]
    },

    {
      "monitor": [
        {"type": "resource_ready", "prepare": "41μm nylon screen, empty centrifuge tube"}
      ],
      "subtasks": [
        {"action": "filter_cell_suspension", "source": "centrifuge tube containing cell suspension", "filter_tool": "41μm nylon screen", "target": "empty centrifuge tube"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "cell suspension from old centrifuge tube filtered"},
        {"type": "resource_ready", "prepare": "MSS containing 5% serum"}
      ],
      "subtasks": [
        {"action": "aspirate", "object": "MSS containing 5% serum", "amount": "5mL"},
        {"action": "dispense", "place": "the inner surface of the 41μm nylon screen", "amount": "5mL"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "centrifuge tube containing the filtered cell suspension collected after the final filtration"}
      ],
      "subtasks": [
        {"action": "put_into_centrifuge", "object": "centrifuge tube"},
        {"action": "set_centrifuge", "force": "100g", "time": "5min"},
        {"action": "start_device", "device": "centrifuge"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "time": "5min", "device": "centrifuge"}
      ],
      "subtasks": [
        {"action": "take_out_centrifuge", "object": "centrifuge tube"},
        {"action": "discard_supernatant", "object": "centrifuge tube"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "supernatant removed"},
        {"type": "resource_ready", "prepare": "WAJC 404 culture medium"}
      ],
      "subtasks": [
        {"action": "aspirate", "object": "WAJC 404 culture medium", "amount": "5mL"},
        {"action": "dispense", "place": "centrifuge tube", "amount": "5mL"},
        {"action": "resuspension", "object": "centrifuge tube"}
      ]
    },

    {
      "monitor": [
        {"type": "resource_ready", "prepare": "trypan blue solution, hemocytometer, empty tube"}
      ],
      "subtasks": [
        {"action": "count_cells_trypan_blue", "source": "centrifuge tube"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "the cell counting results have been obtained, and the required volume of medium to be added (V mL) has been calculated based on the target density"},
        {"type": "resource_ready", "prepare": "WAJC 404 culture medium, 24-well plate"}
      ],
      "subtasks": [
        {"action": "cell_dilution", "target": "centrifuge tube", "diluent": "WAJC 404 culture medium", "density": "4×10^6 cell/mL"},
        {"action": "cell_seed", "source": "centrifuge tube", "plate": "24-well plate", "volume": "50μL"},
        {"action": "add_reagent_to_plate", "reagent": "WAJC 404 culture medium", "plate": "24-well plate", "volume": "1mL"},
        {"action": "put_into_incubator", "object": "24-well plate"},
        {"action": "set_incubator", "CO2": "5%", "temp": "37℃"},
        {"action": "start_device", "device": "incubator"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "device": "incubator", "time": "3d"},
        {"type": "resource_ready", "prepare": "WAJC 404 culture medium"}
      ],
      "subtasks": [
        {"action": "take_out_incubator", "object": "24-well plate"},
        {"action": "discard_medium", "object": "24-well plate"},
        {"action": "add_reagent_to_plate", "reagent": "WAJC 404 culture medium", "plate": "24-well plate", "volume": "1mL"},
        {"action": "put_into_incubator", "object": "24-well plate"},
        {"action": "set_incubator", "CO2": "5%", "temp": "37℃"},
        {"action": "start_device", "device": "incubator"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "device": "incubator", "time": "2d"},
        {"type": "resource_ready", "prepare": "WAJC 404 culture medium"}
      ],
      "subtasks": [
        {"action": "take_out_incubator", "object": "24-well plate"},
        {"action": "discard_medium", "object": "24-well plate"},
        {"action": "add_reagent_to_plate", "reagent": "WAJC 404 culture medium", "plate": "24-well plate", "volume": "1mL"},
        {"action": "put_into_incubator", "object": "24-well plate"},
        {"action": "set_incubator", "CO2": "5%", "temp": "37℃"},
        {"action": "start_device", "device": "incubator"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "device": "incubator", "time": "2d"}
      ],
      "subtasks": [
        {"action": "take_out_incubator", "object": "24-well plate"}
      ]
    }
  ]
}