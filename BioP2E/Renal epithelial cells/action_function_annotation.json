{
  "stages": [
    {
      "monitor": [
        {"type": "resource_ready", "prepare": "centrifuge tube containing renal cortex tissue, physiological saline"}
      ],
      "subtasks": [
        {"action": "resuspension", "object": "centrifuge tube"},
        {"action": "put_into_centrifuge", "object": "centrifuge tube"},
        {"action": "set_centrifuge", "speed": "1000r/min", "time": "10min"},
        {"action": "start_device", "device": "centrifuge"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "time": "10min", "device": "centrifuge"}
      ],
      "subtasks": [
        {"action": "take_out_centrifuge", "object": "centrifuge tube"},
        {"action": "discard_supernatant", "object": "centrifuge tube"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "supernatant removed"},
        {"type": "resource_ready", "prepare": "0.2% trypsin"}
      ],
      "subtasks": [
        {"action": "aspirate", "object": "0.2% trypsin", "amount": "2mL"},
        {"action": "dispense", "place": "centrifuge tube", "amount": "2mL"},
        {"action": "resuspension", "object": "centrifuge tube"},
        {"action": "put_into_device", "device": "shaking water bath","object": "centrifuge tube"},
        {"action": "set_device", "device": "shaking water bath", "temp": "37℃", "time": "20min"},
        {"action": "start_device", "device": "shaking water bath"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "device": "shaking water bath", "time": "20min"}
      ],
      "subtasks": [
        {"action": "take_out_device", "device": "shaking water bath","object": "centrifuge tube"},
        {"action": "put_into_centrifuge", "object": "centrifuge tube"},
        {"action": "set_centrifuge", "speed": "1500r/min", "time": "5min"},
        {"action": "start_device", "device": "centrifuge"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "time": "5min", "device": "centrifuge"}
      ],
      "subtasks": [
        {"action": "take_out_centrifuge", "object": "centrifuge tube"},
        {"action": "discard_supernatant", "object": "centrifuge tube"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "supernatant removed"},
        {"type": "resource_ready", "prepare": "RPMI 1640 medium containing 10% newborn calf serum, culture flask"}
      ],
      "subtasks": [
        {"action": "aspirate", "object": "RPMI 1640 medium containing 10% newborn calf serum", "amount": "5mL"},
        {"action": "dispense", "place": "centrifuge tube", "amount": "5mL"},
        {"action": "resuspension", "object": "centrifuge tube"},
        {"action": "transfer_liquid", "source": "centrifuge tube", "target": "culture flask"},
        {"action": "put_into_incubator", "object": "culture flask"},
        {"action": "set_incubator", "temp": "37℃", "CO2": "5%"},
        {"action": "start_device", "device": "incubator"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "device": "incubator", "time": "6d"}
      ],
      "subtasks": [
        {"action": "take_out_incubator", "object": "culture flask"},
        {"action": "microscopic_observe", "object": "cells in the culture flask"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "cells cover the bottom of the culture flask"}
      ],
      "subtasks": [
        {"action": "transfer", "object": "culture flask", "source": "microscopic observation area", "target": "workspace"},
        {"action": "discard_medium", "object": "culture flask"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "medium in the culture flask removed"},
        {"type": "resource_ready", "prepare": "serum-free RPMI 1640 medium"}
      ],
      "subtasks": [
        {"action": "aspirate", "object": "serum-free RPMI 1640 medium", "amount": "2mL"},
        {"action": "dispense", "place": "culture flask", "amount": "2mL"},
        {"action": "shake", "object": "culture flask"},
        {"action": "discard_medium", "object": "culture flask"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "medium in the culture flask removed"},
        {"type": "resource_ready", "prepare": "0.2% trypsin"}
      ],
      "subtasks": [
        {"action": "aspirate", "object": "0.2% trypsin", "amount": "2mL"},
        {"action": "dispense", "place": "culture flask", "amount": "2mL"},
        {"action": "put_into_incubator", "object": "culture flask"},
        {"action": "set_incubator", "temp": "37℃", "CO2": "5%"},
        {"action": "start_device", "device": "incubator"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "device": "incubator", "time": "5min"}
      ],
      "subtasks": [
        {"action": "take_out_incubator", "object": "culture flask"},
        {"action": "microscopic_observe", "object": "cells in the culture flask"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "about 85% of the cells in the culture flask shrink, become round, and partially detach"},
        {"type": "resource_ready", "prepare": "RPMI 1640 medium containing 10% newborn calf serum, centrifuge tube"}
      ],
      "subtasks": [
        {"action": "transfer", "object": "culture flask", "source": "microscopic observation area", "target": "workspace"},
        {"action": "aspirate", "object": "RPMI 1640 medium containing 10% newborn calf serum", "amount": "4mL"},
        {"action": "dispense", "place": "centrifuge tube", "amount": "4mL"},
        {"action": "shake", "object": "culture flask"},
        {"action": "resuspension", "object": "culture flask"},
        {"action": "transfer_liquid", "source": "culture flask", "target": "centrifuge tube"},
        {"action": "put_into_centrifuge", "object": "centrifuge tube"},
        {"action": "set_centrifuge", "speed": "1500r/min", "time": "5min"},
        {"action": "start_device", "device": "centrifuge"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "time": "5min", "device": "centrifuge"}
      ],
      "subtasks": [
        {"action": "take_out_centrifuge", "object": "centrifuge tube"},
        {"action": "discard_supernatant", "object": "centrifuge tube"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "supernatant removed"},
        {"type": "resource_ready", "prepare": "RPMI 1640 medium containing 10% newborn calf serum"}
      ],
      "subtasks": [
        {"action": "aspirate", "object": "RPMI 1640 medium containing 10% newborn calf serum", "amount": "2mL"},
        {"action": "dispense", "place": "centrifuge tube", "amount": "2mL"},
        {"action": "resuspension", "object": "centrifuge tube"}
      ]
    },

    {
      "monitor": [
        {"type": "resource_ready", "prepare": "trypan blue solution, hemocytometer, empty tube"}
      ],
      "subtasks": [
        {"action": "count_cells_trypan_blue", "source": "centrifuge tube"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "obtain the counting result"},
        {"type": "resource_ready", "prepare": "RPMI 1640 medium containing 10% newborn calf serum, culture flasks"}
      ],
      "subtasks": [
        {"action": "cell_dilution", "target": "centrifuge tube", "diluent": "RPMI 1640 medium containing 10% newborn calf serum"},
        {"action": "cell_seed", "source": "centrifuge tube", "plate": "culture flask", "volume": "2mL"},
        {"action": "put_into_incubator", "object": "culture flasks"},
        {"action": "set_incubator", "CO2": "5%", "temp": "37℃"},
        {"action": "start_device", "device": "incubator"}
      ]
    }
  ]
}