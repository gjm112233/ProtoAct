{
  "stages": [
    {
      "monitor": [
        {"type": "resource_ready", "prepare": "20 mL umbilical cord blood, placed in 250 mL dropper bottle, 6% hydroxyethyl starch sodium chloride injection"}
      ],
      "subtasks": [
        {"action": "aspirate", "object": "6% hydroxyethyl starch sodium chloride injection", "amount": "5mL"},
        {"action": "dispense", "place": "250 mL dropper bottle", "amount": "5mL"},
        {"action": "shake", "object": "250 mL dropper bottle"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "time": "45min"},
        {"type": "resource_ready", "prepare": "centrifuge tube"}
      ],
      "subtasks": [
        {"action": "aspirate", "object": "250 mL dropper bottle", "amount": "3mL"},
        {"action": "dispense", "place": "centrifuge tube", "amount": "5mL"},
        {"action": "put_into_centrifuge", "object": "centrifuge tube"},
        {"action": "set_centrifuge", "speed": "1000r/min", "time": "8min"},
        {"action": "start_device", "device": "centrifuge"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "time": "8min", "device": "centrifuge"}
      ],
      "subtasks": [
        {"action": "take_out_centrifuge", "object": "centrifuge tube"},
        {"action": "discard_supernatant", "object": "centrifuge tube"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "supernatant removed"},
        {"type": "resource_ready", "prepare": "IMDM medium"}
      ],
      "subtasks": [
        {"action": "aspirate", "object": "IMDM medium", "amount": "5mL"},
        {"action": "dispense", "place": "centrifuge tube", "amount": "5mL"},
        {"action": "resuspension", "object": "centrifuge tube"},
        {"action": "put_into_centrifuge", "object": "centrifuge tube"},
        {"action": "set_centrifuge", "speed": "1000r/min", "time": "5min"},
        {"action": "start_device", "device": "centrifuge"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "time": "5min", "device": "centrifuge"}
      ],
      "subtasks": [
        {"action": "take_out_centrifuge", "object": "centrifuge tube"},
        {"action": "discard_supernatant", "object": "centrifuge tube"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "supernatant removed"},
        {"type": "resource_ready", "prepare": "IMDM medium"}
      ],
      "subtasks": [
        {"action": "aspirate", "object": "IMDM medium", "amount": "5mL"},
        {"action": "dispense", "place": "centrifuge tube", "amount": "5mL"},
        {"action": "resuspension", "object": "centrifuge tube"},
        {"action": "repeat", "back": "put_into_centrifuge", "count": "1"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "wash twice by centrifugation"},
        {"type": "resource_ready", "prepare": "trypan blue solution, hemocytometer, empty tube"}
      ],
      "subtasks": [
        {"action": "count_cells_trypan_blue", "source": "centrifuge tube"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "cell counting results have been obtained, the required volume of medium to be added (V mL) has been calculated based on the target density"},
        {"type": "resource_ready", "prepare": "IMDM medium supplemented with 20% FBS, 35 mm 6-well plate"}
      ],
      "subtasks": [
        {"action": "cell_dilution", "target": "centrifuge tube", "diluent": "IMDM medium supplemented with 20% FBS", "density": "1×10^9 cell/mL"},
        {"action": "cell_seed", "source": "centrifuge tube", "plate": "35 mm 6-well plate", "volume": "2mL"},
        {"action": "put_into_incubator", "object": "35 mm 6-well plate"},
        {"action": "set_incubator", "CO2": "5%", "temp": "37℃"},
        {"action": "start_device", "device": "incubator"}
      ]
    }
  ]
}