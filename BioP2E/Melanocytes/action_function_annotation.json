{
  "stages": [
    {
      "monitor": [
        {"type": "resource_ready", "prepare": "minced skin tissue, petri dish containing 0.25% trypsin"}
      ],
      "subtasks": [
        {"action": "transfer", "object": "minced skin tissue (epidermal side face up)", "source": "workspace", "target": "petri dish containing 0.25% trypsin"},
        {"action": "put_into_device", "device": "refrigerator", "object": "petri dish"},
        {"action": "set_device", "device": "refrigerator", "temp": "4℃"},
        {"action": "start_device", "device": "refrigerator"}

      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "time": "24h", "device": "refrigerator"}
      ],
      "subtasks": [
        {"action": "take_out_device", "device": "refrigerator", "object": "petri dish"},
        {"action": "discard_medium", "object": "petri dish"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "0.25% trypsin in petri dish removed"},
        {"type": "resource_ready", "prepare": "D-Hanks solution"}
      ],
      "subtasks": [
        {"action": "aspirate", "object": "D-Hanks solution", "amount": "2mL"},
        {"action": "dispense", "place": "petri dish", "amount": "2mL"},
        {"action": "shake", "object": "petri dish"},
        {"action": "discard_medium", "object": "petri dish"},
        {"action": "microscopic_observe", "object": "skin tissue in petri dish"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "epidermis and dermis at the edge of skin tissue separated"},
        {"type": "resource_ready", "prepare": "new 10cm plastic petri dish, complete medium containing serum"}
      ],
      "subtasks": [
        {"action": "transfer", "object": "minced skin tissue", "source": "original petri dish", "target": "new 10cm plastic petri dish"},
        {"action": "aspirate", "object": "complete medium containing serum", "amount": "5mL"},
        {"action": "dispense", "place": "new 10cm plastic petri dish", "amount": "5mL"},
        {"action": "shake", "object": "new 10cm plastic petri dish"},
        {"action": "discard_medium", "object": "new 10cm plastic petri dish"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "medium in plastic petri dish removed"},
        {"type": "resource_ready", "prepare": "50mL centrifuge tube, DMEM medium"}
      ],
      "subtasks": [
        {"action": "transfer", "object": "skin epidermis", "source": "10cm plastic petri dish", "target": "50mL centrifuge tube"},
        {"action": "aspirate", "object": "DMEM medium", "amount": "20mL"},
        {"action": "dispense", "place": "50mL centrifuge tube", "amount": "20mL"},
        {"action": "resuspension", "object": "50mL centrifuge tube"},
        {"action": "put_into_centrifuge", "object": "50mL centrifuge tube"},
        {"action": "set_centrifuge", "speed": "2000r/min", "time": "5min"},
        {"action": "start_device", "device": "centrifuge"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "time": "5min", "device": "centrifuge"}
      ],
      "subtasks": [
        {"action": "take_out_centrifuge", "object": "50mL centrifuge tube"},
        {"action": "discard_supernatant", "object": "50mL centrifuge tube"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "supernatant removed"},
        {"type": "resource_ready", "prepare": "D-Hanks solution"}
      ],
      "subtasks": [
        {"action": "aspirate", "object": "D-Hanks solution", "amount": "20mL"},
        {"action": "dispense", "place": "50mL centrifuge tube", "amount": "20mL"},
        {"action": "resuspension", "object": "50mL centrifuge tube"},
        {"action": "repeat", "back": "put_into_centrifuge", "count": "2"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "centrifugation washing completed three times"},
        {"type": "resource_ready", "prepare": "melanocyte growth medium"}
      ],
      "subtasks": [
        {"action": "discard_supernatant", "object": "50mL centrifuge tube"},
        {"action": "aspirate", "object": "melanocyte growth medium", "amount": "20mL"},
        {"action": "dispense", "place": "50mL centrifuge tube", "amount": "20mL"},
        {"action": "resuspension", "object": "50mL centrifuge tube"}
      ]
    },

    {
      "monitor": [
        {"type": "resource_ready", "prepare": "trypan blue solution, hemocytometer, empty tube"}
      ],
      "subtasks": [
        {"action": "count_cells_trypan_blue", "source": "50mL centrifuge tube"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "cell counting results have been obtained, and the required volume of medium to be added (V mL) has been calculated based on the target concentration"},
        {"type": "resource_ready", "prepare": "melanocyte growth medium, culture flask"}
      ],
      "subtasks": [
        {"action": "cell_dilution", "target": "50mL centrifuge tube", "diluent": "melanocyte growth medium", "density": "2×10^5 cell/mL"},
        {"action": "cell_seed", "source": "50mL centrifuge tube", "plate": "culture flask", "volume": "2mL"},
        {"action": "put_into_incubator", "object": "culture flask"},
        {"action": "set_incubator", "CO2": "5%", "temp": "37℃"},
        {"action": "start_device", "device": "incubator"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "device": "incubator", "time": "72h"}
      ],
      "subtasks": [
        {"action": "take_out_incubator", "object": "culture flask"}
      ]
    }
  ]
}