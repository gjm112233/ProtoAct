{
  "stages": [
    {
      "monitor": [
        {"type": "resource_ready", "prepare": "dental pulp tissue, culture dish, type I collagenase solution, dispase solution"}
      ],
      "subtasks": [
        {"action": "transfer", "object": "dental pulp tissue", "source": "workspace", "target": "culture dish"},
        {"action": "aspirate", "object": "type I collagenase solution", "amount": "3mL"},
        {"action": "dispense", "place": "culture dish", "amount": "3mL"},
        {"action": "aspirate", "object": "dispase solution", "amount": "4mL"},
        {"action": "dispense", "place": "culture dish", "amount": "4mL"},
        {"action": "shake", "object": "culture dish"},
        {"action": "put_into_incubator", "object": "culture dish"},
        {"action": "set_incubator", "temp": "37℃", "CO2": "5%"},
        {"action": "start_device", "device": "incubator"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "time": "1h", "device": "incubator"},
        {"type": "resource_ready", "prepare": "70 μm cell strainer, centrifuge tube"}
      ],
      "subtasks": [
        {"action": "take_out_incubator", "object": "culture dish"},
        {"action": "filter_cell_suspension", "source": "culture dish", "filter_tool": "70 μm cell strainer", "target": "centrifuge tube"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "cell suspension from culture dish filtered"},
        {"type": "resource_ready", "prepare": "DMEM culture medium"}
      ],
      "subtasks": [
        {"action": "aspirate", "object": "DMEM culture medium", "amount": "2mL"},
        {"action": "dispense", "place": "the inner surface of the 70 μm cell strainer", "amount": "2mL"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "all filtrate collected in centrifuge tube"}
      ],
      "subtasks": [
        {"action": "put_into_centrifuge", "object": "centrifuge tube"},
        {"action": "set_centrifuge", "speed": "1000r/min", "time": "5min"},
        {"action": "start_device", "device": "centrifuge"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "time": "5min", "device": "centrifuge"}
      ],
      "subtasks": [
        {"action": "take_out_centrifuge", "object": "centrifuge tube"},
        {"action": "discard_supernatant", "object": "centrifuge tube"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "supernatant removed"},
        {"type": "resource_ready", "prepare": "DMEM culture medium"}
      ],
      "subtasks": [
        {"action": "aspirate", "object": "DMEM culture medium", "amount": "2mL"},
        {"action": "dispense", "place": "centrifuge tube", "amount": "2mL"},
        {"action": "resuspension", "object": "centrifuge tube"},
        {"action": "repeat", "back": "put_into_centrifuge", "count": "1"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "centrifuge and wash twice"},
        {"type": "resource_ready", "prepare": "trypan blue solution, hemocytometer, empty tube"}
      ],
      "subtasks": [
        {"action": "count_cells_trypan_blue", "source": "centrifuge tube"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "cell counting results have been obtained, the required volume of medium to be added (V mL) has been calculated based on the target density"},
        {"type": "resource_ready", "prepare": "DMEM culture medium, 35 mm culture dish"}
      ],
      "subtasks": [
        {"action": "cell_dilution", "target": "centrifuge tube", "diluent": "DMEM culture medium", "density": "1×10^3 cell/mL"},
        {"action": "cell_seed", "source": "centrifuge tube", "plate": "35 mm culture dish", "volume": "2mL"},
        {"action": "put_into_incubator", "object": "35 mm culture dish"},
        {"action": "set_incubator", "CO2": "5%", "temp": "37℃"},
        {"action": "start_device", "device": "incubator"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "time": "7d", "device": "incubator"}
      ],
      "subtasks": [
        {"action": "take_out_incubator", "object": "35 mm culture dish"}
      ]
    }
  ]
}