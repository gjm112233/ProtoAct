{
  "stages": [
    {
      "monitor": [
          {"type": "wait_time", "device": "incubator", "time": "3d"}
      ],
      "subtasks": [
          {"action": "take_out_incubator", "object": "culture dish"},
          {"action": "transfer_liquid", "source": "culture dish", "target": "centrifuge_tube"},
          {"action": "put_into_centrifuge", "object": "centrifuge tube"},
          {"action": "set_centrifuge", "force": "800g", "time": "6min"},
          {"action": "start_device", "device": "centrifuge"}
      ]
    },

    {
      "monitor": [
          {"type": "wait_time", "time": "6min", "device": "centrifuge"}
      ],
      "subtasks": [
          {"action":"take_out_centrifuge", "object": "centrifuge tube" },
          {"action": "discard_supernatant", "object": "centrifuge tube"}
      ]
    },

    {
      "monitor":[
          {"type": "visual_state", "observe": "supernatant removed"},
          {"type": "resource_ready", "prepare": "cryopreservation liquid, several cell cryopreservation tubes"}
      ],
      "subtasks": [
          {"action":"cell_dilution", "target": "centrifuge tube", "diluent":"cryopreservation liquid", "density": "1×10^6 cell/mL"},
          {"action": "cell_storage", "source": "centrifuge tube", "container": "cell cryopreservation tubes", "volume": "1mL"},
          {"action": "put_into_device", "object": "cell cryopreservation tubes", "target": "fridge"},
          {"action": "set_device", "device": "fridge", "temp": "-80℃"}
      ]
    },

    {
      "monitor":[
          {"type": "wait_time", "time": "12h"}
      ],
      "subtasks": [
          {"action": "transfer", "object": "cell cryopreservation tubes", "source": "fridge", "target": "liquid nitrogen tank"}
      ]
    }
  ]
}