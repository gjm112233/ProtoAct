{
  "stages": [
    {
      "monitor": [
        {"type": "resource_ready", "prepare": "rabbit lymph node, culture dish containing HBSS, surgical tools"}
      ],
      "subtasks": [
        {"action": "transfer", "object": "rabbit lymph node", "source": "workspace", "target": "culture dish containing HBSS"},
        {"action": "cut_in_piece", "target": "rabbit lymph node in culture dish", "volume": "1mm³"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "rabbit lymph node cut into 1mm³ fragments"}
      ],
      "subtasks": [
        {"action": "put_into_device", "device": "shaking water bath", "object": "culture dish"},
        {"action": "set_device", "temp": "37℃", "time": "20min"},
        {"action": "start_device", "device": "shaking water bath"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "time": "20min", "device": "shaking water bath"}
      ],
      "subtasks": [
        {"action": "take_out_device", "device": "shaking water bath", "object": "culture dish"},
        {"action": "resuspension", "object": "culture dish"}
      ]
    },

    {
      "monitor": [
        {"type": "resource_ready", "prepare": "100-mesh strainer, centrifuge tube"}
      ],
      "subtasks": [
        {"action": "filter_cell_suspension", "source": "culture dish", "filter_tool": "100-mesh strainer", "target": "centrifuge tube"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "cell suspension from culture dish filtered"},
        {"type": "resource_ready", "prepare": "DMEM culture medium"}
      ],
      "subtasks": [
        {"action": "aspirate", "object": "DMEM culture medium", "amount": "2mL"},
        {"action": "dispense", "place": "the inner surface of 100-mesh strainer", "amount": "2mL"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "all filtrate collected in centrifuge tube"}
      ],
      "subtasks": [
        {"action": "put_into_centrifuge", "object": "centrifuge tube"},
        {"action": "set_centrifuge", "speed": "1000r/min", "time": "10min"},
        {"action": "start_device", "device": "centrifuge"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "time": "10min", "device": "centrifuge"}
      ],
      "subtasks": [
        {"action": "take_out_centrifuge", "object": "centrifuge tube"},
        {"action": "discard_supernatant", "object": "centrifuge tube"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "supernatant removed"},
        {"type": "resource_ready", "prepare": "DMEM culture medium"}
      ],
      "subtasks": [
        {"action": "aspirate", "object": "DMEM culture medium", "amount": "5mL"},
        {"action": "dispense", "place": "centrifuge tube", "amount": "5mL"},
        {"action": "resuspension", "object": "centrifuge tube"},
        {"action": "repeat", "back": "put_into_centrifuge", "count": "1"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "centrifuge and wash twice"},
        {"type": "resource_ready", "prepare": "culture dish, DMEM culture medium"}
      ],
      "subtasks": [
        {"action": "transfer_liquid", "source": "centrifuge tube", "target": "culture dish"},
        {"action": "aspirate", "object": "DMEM culture medium", "amount": "2mL"},
        {"action": "dispense", "place": "culture dish", "amount": "2mL"},
        {"action": "resuspension", "object": "culture dish"},
        {"action": "put_into_incubator", "object": "culture dish"},
        {"action": "set_incubator", "CO2": "5%", "temp": "37℃"},
        {"action": "start_device", "device": "incubator"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "time": "30min", "device": "incubator"},
        {"type": "resource_ready", "prepare": "DMEM culture medium, centrifuge tube"}
      ],
      "subtasks": [
        {"action": "take_out_incubator", "object": "culture dish"},
        {"action": "discard_medium", "object": "culture dish"},
        {"action": "aspirate", "object": "DMEM culture medium", "amount": "5mL"},
        {"action": "dispense", "place": "culture dish", "amount": "5mL"},
        {"action": "transfer_liquid", "source": "culture dish", "target": "centrifuge tube"},
        {"action": "put_into_centrifuge", "object": "centrifuge tube"},
        {"action": "set_centrifuge", "speed": "1000r/min", "time": "10min"},
        {"action": "start_device", "device": "centrifuge"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "time": "10min", "device": "centrifuge"}
      ],
      "subtasks": [
        {"action": "take_out_centrifuge", "object": "centrifuge tube"},
        {"action": "discard_supernatant", "object": "centrifuge tube"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "supernatant removed"},
        {"type": "resource_ready", "prepare": "trypan blue solution, hemocytometer, empty tube"}
      ],
      "subtasks": [
        {"action": "count_cells_trypan_blue", "source": "centrifuge tube"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "cell counting results have been obtained, the required volume of medium to be added (V mL) has been calculated based on the target density"},
        {"type": "resource_ready", "prepare": "DMEM culture medium, culture dish"}
      ],
      "subtasks": [
        {"action": "cell_dilution", "target": "centrifuge tube", "diluent": "DMEM culture medium", "density": "1×10^6 cell/mL"},
        {"action": "cell_seed", "source": "centrifuge tube", "plate": "culture dish", "volume": "2mL"},
        {"action": "put_into_incubator", "object": "culture dish"},
        {"action": "set_incubator", "CO2": "5%", "temp": "37℃"},
        {"action": "start_device", "device": "incubator"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "time": "48h", "device": "incubator"}
      ],
      "subtasks": [
        {"action": "take_out_incubator", "object": "culture dish"}
      ]
    }
  ]
}