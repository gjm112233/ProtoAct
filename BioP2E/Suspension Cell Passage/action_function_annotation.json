{
  "stages": [
      {
          "monitor": [
                {"type": "wait_time", "device": "incubator", "time": "24h"}
          ],
          "subtasks": [
                {"action": "take_out_incubator", "object": "culture dish"},
                {"action": "microscopic_observe", "object": "culture dish"}
          ]
      },

      {
          "monitor": [
                {"type": "visual_state", "observe": "cells gather in large groups"},
                {"type": "resource_ready", "prepare": "centrifuge tube"}
          ],
          "subtasks": [
                {"action": "transfer", "object": "culture dish", "source": "microscopic observation area", "target": "workspace"},
                {"action": "resuspension", "object": "culture dish"},
                {"action":"transfer_liquid", "source":"culture dish", "target": "centrifuge tube"},
                {"action": "put_into_centrifuge", "object": "centrifuge tube"},
                {"action": "set_centrifuge", "force": "800g", "time": "6min"},
                {"action": "start_device", "device": "centrifuge"}
            ]
      },

      {
          "monitor": [
                {"type": "wait_time", "time": "6min", "device": "centrifuge"}
          ],
          "subtasks": [
                {"action": " take_out_centrifuge ", "object": " centrifuge tube"},
                {"action": " discard_supernatant ", "object": "centrifuge tube"}
          ]
      },

      {
          "monitor": [
                {"type": "visual_state", "observe": "supernatant removed"},
                {"type": "resource_ready", "observe": "serum containing culture medium"}
          ],
          "subtasks": [
                {"action": "aspirate", "object":"serum containing culture medium", "amount": "2mL"},
                {"action": " dispense", "place": "centrifuge tube", "amount": "2mL"},
                {"action": " resuspension", "object": "centrifuge tube"}
          ]
      },

      {
          "monitor":[
                {"type": "visual_state", "observe": "the sediment at the bottom of the centrifuge tube disappears"},
                {"type": "resource_ready", "prepare": "a culture dish, serum containing culture medium"}
          ],
          "subtasks": [
                {"action": "aspirate", "object": "serum containing culture medium", "amount": "5mL"},
                {"action": "dispense", "place": "culture dish", "amount": "5mL"},
                {"action": "aspirate", "object": "cell fluid in centrifuge tube", "amount": "500μL"},
                {"action": "dispense", "place": "culture dish", "amount": "500μL"},
                {"action": "shake", "object": "culture dish"},
                {"action": "put_into_incubator", "object": "culture dish"},
                {"action": "set_incubator", "CO2": "5%", "temp": "37℃"},
                {"action": "start_device", "device": "incubator"}
          ]
      }
  ]
}