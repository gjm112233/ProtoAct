{
  "stages": [
    {
      "monitor": [
        {"type": "resource_ready", "prepare": "cartilage tissue cut into 1 mm³ pieces, glass petri dish, GBSS"}
      ],
      "subtasks": [
        {"action": "transfer", "object": "cartilage tissue pieces", "source": "workspace", "target": "glass petri dish"},
        {"action": "aspirate", "object": "GBSS", "amount": "10mL"},
        {"action": "dispense", "place": "glass petri dish", "amount": "10mL"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "time": "10min"},
        {"type": "resource_ready", "prepare": "hyaluronidase"}
      ],
      "subtasks": [
        {"action": "discard_medium", "object": "glass petri dish"},
        {"action": "aspirate", "object": "hyaluronidase", "amount": "4mL"},
        {"action": "dispense", "place": "glass petri dish", "amount": "4mL"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "time": "5min"},
        {"type": "resource_ready", "prepare": "hyaluronidase"}
      ],
      "subtasks": [
        {"action": "discard_medium", "object": "glass petri dish"},
        {"action": "aspirate", "object": "hyaluronidase", "amount": "8mL"},
        {"action": "dispense", "place": "glass petri dish", "amount": "8mL"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "time": "10min"},
        {"type": "resource_ready", "prepare": "GBSS"}
      ],
      "subtasks": [
        {"action": "discard_medium", "object": "glass petri dish"},
        {"action": "aspirate", "object": "GBSS", "amount": "5mL"},
        {"action": "dispense", "place": "glass petri dish", "amount": "5mL"},
        {"action": "shake", "object": "glass petri dish"},
        {"action": "discard_medium", "object": "glass petri dish"},
        {"action": "repeat", "back": "aspirate", "count": "1"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "wash cartilage tissue pieces twice with GBSS"},
        {"type": "resource_ready", "prepare": "25 mL screw-cap tube, trypsin"}
      ],
      "subtasks": [
        {"action": "transfer", "object": "cartilage tissue pieces", "source": "glass petri dish", "target": "25 mL screw-cap tube"},
        {"action": "aspirate", "object": "trypsin", "amount": "2mL"},
        {"action": "dispense", "place": "25 mL screw-cap tube", "amount": "2mL"},
        {"action": "shake", "object": "25 mL screw-cap tube"},
        {"action": "discard_medium", "object": "25 mL screw-cap tube"},
        {"action": "repeat", "back": "aspirate", "count": "1"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "trypsin in screw-cap tube removed"},
        {"type": "resource_ready", "prepare": "trypsin"}
      ],
      "subtasks": [
        {"action": "aspirate", "object": "trypsin", "amount": "4mL"},
        {"action": "dispense", "place": "25 mL screw-cap tube", "amount": "4mL"},
        {"action": "put_into_incubator", "object": "25 mL screw-cap tube"},
        {"action": "set_incubator", "CO2": "5%", "temp": "37℃"},
        {"action": "start_device", "device": "incubator"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "time": "30min", "device": "incubator"},
        {"type": "resource_ready", "prepare": "GBSS"}
      ],
      "subtasks": [
        {"action": "take_out_incubator", "object": "25 mL screw-cap tube"},
        {"action": "discard_medium", "object": "25 mL screw-cap tube"},
        {"action": "aspirate", "object": "GBSS", "amount": "5mL"},
        {"action": "dispense", "place": "25 mL screw-cap tube", "amount": "5mL"},
        {"action": "shake", "object": "25 mL screw-cap tube"},
        {"action": "discard_medium", "object": "25 mL screw-cap tube"},
        {"action": "repeat", "back": "aspirate", "count": "1"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "wash twice with GBSS"},
        {"type": "resource_ready", "prepare": "0.2% collagenase"}
      ],
      "subtasks": [
        {"action": "aspirate", "object": "0.2% collagenase", "amount": "2mL"},
        {"action": "dispense", "place": "25 mL screw-cap tube", "amount": "2mL"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "time": "5min"},
        {"type": "resource_ready", "prepare": "collagenase"}
      ],
      "subtasks": [
        {"action": "discard_medium", "object": "25 mL screw-cap tube"},
        {"action": "aspirate", "object": "collagenase", "amount": "4mL"},
        {"action": "dispense", "place": "25 mL screw-cap tube", "amount": "4mL"},
        {"action": "put_into_incubator", "object": "25 mL screw-cap tube"},
        {"action": "set_incubator", "CO2": "5%", "temp": "37℃"},
        {"action": "start_device", "device": "incubator"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "time": "90min", "device": "incubator"},
        {"type": "resource_ready", "prepare": "centrifuge tube"}
      ],
      "subtasks": [
        {"action": "take_out_incubator", "object": "25 mL screw-cap tube"},
        {"action": "transfer_liquid", "source": "supernatant in 25 mL screw-cap tube", "target": "centrifuge tube"},
        {"action": "put_into_centrifuge", "object": "centrifuge tube"},
        {"action": "set_centrifuge", "force": "600g", "time": "8min"},
        {"action": "start_device", "device": "centrifuge"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "time": "8min", "device": "centrifuge"}
      ],
      "subtasks": [
        {"action": "take_out_centrifuge", "object": "centrifuge tube"},
        {"action": "discard_supernatant", "object": "centrifuge tube"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "supernatant removed"},
        {"type": "resource_ready", "prepare": "F12 medium containing 20% FBS"}
      ],
      "subtasks": [
        {"action": "aspirate", "object": "F12 medium containing 20% FBS", "amount": "8mL"},
        {"action": "dispense", "place": "centrifuge tube", "amount": "8mL"},
        {"action": "resuspension", "object": "centrifuge tube"},
        {"action": "put_into_centrifuge", "object": "centrifuge tube"},
        {"action": "set_centrifuge", "force": "180g", "time": "1min"},
        {"action": "start_device", "device": "centrifuge"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "time": "1min", "device": "centrifuge"},
        {"type": "resource_ready", "prepare": "new centrifuge tube"}
      ],
      "subtasks": [
        {"action": "take_out_centrifuge", "object": "centrifuge tube"},
        {"action": "transfer_liquid", "source": "supernatant in centrifuge tube", "target": "new centrifuge tube"},
        {"action": "put_into_centrifuge", "object": "new centrifuge tube"},
        {"action": "set_centrifuge", "force": "600g", "time": "10min"},
        {"action": "start_device", "device": "centrifuge"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "time": "10min", "device": "centrifuge"}
      ],
      "subtasks": [
        {"action": "take_out_centrifuge", "object": "centrifuge tube"},
        {"action": "discard_supernatant", "object": "centrifuge tube"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "supernatant removed"},
        {"type": "resource_ready", "prepare": "F12 medium containing 12% FBS, 75 cm² culture flask"}
      ],
      "subtasks": [
        {"action": "aspirate", "object": "F12 medium containing 12% FBS", "amount": "8mL"},
        {"action": "dispense", "place": "centrifuge tube", "amount": "8mL"},
        {"action": "resuspension", "object": "centrifuge tube"},
        {"action": "transfer_liquid", "source": "centrifuge tube", "target": "75 cm² culture flask"},
        {"action": "aspirate", "object": "F12 medium containing 12% FBS", "amount": "4mL"},
        {"action": "dispense", "place": "75 cm² culture flask", "amount": "4mL"},
        {"action": "put_into_incubator", "object": "75 cm² culture flask"},
        {"action": "set_incubator", "CO2": "5%", "temp": "37℃"},
        {"action": "start_device", "device": "incubator"}
      ]
    }
  ]
}