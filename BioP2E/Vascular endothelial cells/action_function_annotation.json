{
  "stages": [
    {
      "monitor": [
        {"type": "resource_ready", "prepare": "cleaned neonatal bovine thoracic aorta, mixed digestion solution, culture dish"}
      ],
      "subtasks": [
        {"action": "aspirate", "object": "mixed digestion solution", "amount": "2mL"},
        {"action": "dispense", "place": "culture dish", "amount": "2mL"},
        {"action": "transfer", "object": "artery", "source": "workspace", "target": "culture dish"},
        {"action": "put_into_device", "device": "water bath", "object": "culture dish"},
        {"action": "set_device", "device": "water bath", "temp": "37℃", "time": "30min"},
        {"action": "start_device", "device": "water bath"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "device": "water bath", "time": "30min"},
        {"type": "resource_ready", "prepare": "M199 medium supplemented with 20% fetal bovine serum"}
      ],
      "subtasks": [
        {"action": "take_out_device","device": "water bath", "object": "culture dish"},
        {"action": "transfer", "object": "artery", "source": "culture dish", "target": "waste container"},
        {"action": "aspirate", "object": "M199 medium supplemented with 20% fetal bovine serum", "amount": "2mL"},
        {"action": "dispense", "place": "culture dish", "amount": "2mL"},
        {"action": "shake", "object": "culture dish"}
      ]
    },

    {
      "monitor": [
        {"type": "resource_ready", "prepare": "centrifuge tube"}
      ],
      "subtasks": [
        {"action": "transfer_liquid", "source": "culture dish", "target": "centrifuge tube"},
        {"action": "put_into_centrifuge", "object": "centrifuge tube"},
        {"action": "set_centrifuge", "speed": "1000r/min", "time": "5min"},
        {"action": "start_device", "device": "centrifuge"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "device": "centrifuge", "time": "5min"},
        {"type": "resource_ready", "prepare": "M199 medium supplemented with 20% fetal bovine serum"}
      ],
      "subtasks": [
        {"action": "take_out_centrifuge", "object": "centrifuge tube"},
        {"action": "discard_supernatant", "object": "centrifuge tube"},
        {"action": "aspirate", "object": "M199 medium supplemented with 20% fetal bovine serum", "amount": "2mL"},
        {"action": "dispense", "place": "centrifuge tube", "amount": "2mL"},
        {"action": "resuspension", "object": "centrifuge tube"},
        {"action": "repeat", "back": "aspirate", "count": "1"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "cells in the culture dish have been washed twice"},
        {"type": "resource_ready", "prepare": "M199 medium supplemented with 20% fetal bovine serum, gelatin-coated culture dish"}
      ],
      "subtasks": [
        {"action": "aspirate", "object": "M199 medium supplemented with 20% fetal bovine serum", "amount": "2mL"},
        {"action": "dispense", "place": "centrifuge tube", "amount": "2mL"},
        {"action": "resuspension", "object": "centrifuge tube"},
        {"action": "cell_seed", "source": "centrifuge tube", "plate": "gelatin-coated culture dish", "volume": "2mL"},
        {"action": "put_into_incubator", "object": "gelatin-coated culture dish"},
        {"action": "set_incubator", "CO2": "5%", "temp": "37℃"},
        {"action": "start_device", "device": "incubator"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "device": "incubator", "time": "24h"}
      ],
      "subtasks": [
        {"action": "take_out_incubator", "object": "gelatin-coated culture dish"},
        {"action": "microscopic_observe", "object": "cells in gelatin-coated culture dish"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "cells in culture dish have reached confluence"},
        {"type": "resource_ready", "prepare": "M199 medium supplemented with 20% fetal bovine serum"}
      ],
      "subtasks": [
        {"action": "transfer", "object": "gelatin-coated culture dish", "source": "microscopic observation area", "target": "workspace"},
        {"action": "discard_medium", "object": "gelatin-coated culture dish"},
        {"action": "aspirate", "object": "M199 medium supplemented with 20% fetal bovine serum", "amount": "2mL"},
        {"action": "dispense", "place": "gelatin-coated culture dish", "amount": "2mL"},
        {"action": "put_into_incubator", "object": "gelatin-coated culture dish"},
        {"action": "set_incubator", "CO2": "5%", "temp": "37℃"},
        {"action": "start_device", "device": "incubator"}
      ]
    }
  ]
}
