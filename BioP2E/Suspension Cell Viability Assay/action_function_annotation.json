{
  "stages": [
    {
      "monitor": [
          {"type": "wait_time", "device": "incubator", "time": "3d"}
      ],
      "subtasks": [
          {"action": "take_out_incubator", "object": "culture dish"},
          {"action": " microscopic_observe", "object": "culture dish"}
      ]
    },

    {
      "monitor": [
          {"type": "visual_state", "observe": "cells are suspended and gathered in large groups"},
          {"type": "resource_ready", "prepare": "centrifuge tube"}
      ],
      "subtasks": [
          {"action": "transfer", "object": "culture dish", "source": "microscopic observation area", "target": "workspace"},
          {"action": " transfer_liquid", "source": "culture dish", "target": "centrifuge_tube"},
          {"action": "put_into_centrifuge", "object": "centrifuge_tube"},
          {"action": " set_centrifuge", "force": "800g", "time": "6min"},
          {"action": " start_device", "device": "centrifuge"}
      ]
    },

    {
      "monitor": [
          {"type": "wait_time", "time": "6min", "device": "centrifuge"}
      ],
      "subtasks": [
          {"action": "take_out_centrifuge", "object": " centrifuge_tube"},
          {"action": " discard_supernatant", "object": "centrifuge_tube"}
      ]
    },

    {
      "monitor": [
          {"type": "visual_state", "observe": "supernatant removed"},
          {"type": "resource_ready", "prepare": "96-well plate"}
      ],
      "subtasks": [
          {"action": "cell_dilution", "target": "centrifuge_tube", "diluent": "serum-free medium", "density": "2×10^5 cell/mL"},
          {"action": "cell_seed", "source": "centrifuge_tube", "plate": "96-well plate", "volume": "100μL"}
      ]
    },

    {
      "monitor": [
          {"type": "resource_ready", "prepare": "96-well plate with 100uL cell suspension per well"}
      ],
      "subtasks": [
          {"action": "gradient_dilution", "diluent": "serum-free medium"},
          {"action": "add_reagent_to_plate", "reagent": "test substance", "plate": "96-well plate", "volume": "100μL"},
          {"action": "put_into_incubator", "object": "96-well plate"},
          {"action": "set_incubator", "CO2": "5%", "temp": "37℃"},
          {"action": "start_device", "device": "incubator"}
      ]
    },

    {
      "monitor": [
          {"type": "wait_time", "time": "48h", "device": "incubator"},
          {"type": "resource_ready", "prepare": "CCK8"}
      ],
      "subtasks": [
          {"action": "take_out_incubator", "object": "96-well plate"},
          {"action": " add_reagent_to_plate", "reagent": "CCK8", "plate": "96-well plate", "volume": "20μL"},
          {"action": "put_into_incubator", "object": "96-well plate"},
          {"action": "set_incubator", "CO2": "5%", "temp": "37℃"},
          {"action": "start_device", "device": "incubator"}
      ]
    },

    {
      "monitor": [
          {"type": "wait_time", "time": "4h", "device": "incubator"}
      ],
      "subtasks": [
          {"action": "take_out_incubator", "object": "96-well plate"},
          {"action": "measure_cell_viability", "object": "96-well plate", "wavelength": "450nm"}
      ]
    }
  ]
}