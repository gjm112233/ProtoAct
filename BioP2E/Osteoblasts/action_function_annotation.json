{
  "stages": [
    {
      "monitor": [
        {"type": "resource_ready", "prepare": "bone fragments cut into 2 mm³ pieces, culture dish, culture medium containing fetal bovine serum"}
      ],
      "subtasks": [
        {"action": "transfer", "object": "bone fragments", "source": "workspace", "target": "culture dish"},
        {"action": "aspirate", "object": "culture medium containing fetal bovine serum", "amount": "10mL"},
        {"action": "dispense", "place": "culture dish", "amount": "10mL"},
        {"action": "shake", "object": "culture dish"},
        {"action": "discard_medium", "object": "culture dish"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "culture medium removed"},
        {"type": "resource_ready", "prepare": "bone cell digestion solution"}
      ],
      "subtasks": [
        {"action": "aspirate", "object": "bone cell digestion solution", "amount": "10mL"},
        {"action": "dispense", "place": "culture dish", "amount": "10mL"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "time": "45min"},
        {"type": "resource_ready", "prepare": "bone cell digestion solution"}
      ],
      "subtasks": [
        {"action": "discard_medium", "object": "culture dish"},
        {"action": "aspirate", "object": "bone cell digestion solution", "amount": "10mL"},
        {"action": "dispense", "place": "culture dish", "amount": "10mL"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "time": "30min"},
        {"type": "resource_ready", "prepare": "centrifuge tube"}
      ],
      "subtasks": [
        {"action": "transfer_liquid", "source": "culture dish", "target": "centrifuge tube"},
        {"action": "put_into_centrifuge", "object": "centrifuge tube"},
        {"action": "set_centrifuge", "force": "580g", "time": "2min"},
        {"action": "start_device", "device": "centrifuge"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "time": "2min", "device": "centrifuge"}
      ],
      "subtasks": [
        {"action": "take_out_centrifuge", "object": "centrifuge tube"},
        {"action": "discard_supernatant", "object": "centrifuge tube"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "supernatant removed"},
        {"type": "resource_ready", "prepare": "Ham’s F12 medium containing 20% fetal bovine serum"}
      ],
      "subtasks": [
        {"action": "aspirate", "object": "Ham’s F12 medium containing 20% fetal bovine serum", "amount": "8mL"},
        {"action": "dispense", "place": "centrifuge tube", "amount": "8mL"},
        {"action": "resuspension", "object": "centrifuge tube"},
        {"action": "put_into_centrifuge", "object": "centrifuge tube"},
        {"action": "set_centrifuge", "force": "580g", "time": "10min"},
        {"action": "start_device", "device": "centrifuge"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "time": "10min", "device": "centrifuge"}
      ],
      "subtasks": [
        {"action": "take_out_centrifuge", "object": "centrifuge tube"},
        {"action": "discard_supernatant", "object": "centrifuge tube"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "supernatant removed"},
        {"type": "resource_ready", "prepare": "complete culture medium, 75 cm² culture flask"}
      ],
      "subtasks": [
        {"action": "aspirate", "object": "complete culture medium", "amount": "4mL"},
        {"action": "dispense", "place": "centrifuge tube", "amount": "4mL"},
        {"action": "resuspension", "object": "centrifuge tube"},
        {"action": "cell_seed", "source": "centrifuge tube", "plate": "75 cm² culture flask", "volume": "4mL"},
        {"action": "aspirate", "object": "complete culture medium", "amount": "8mL"},
        {"action": "dispense", "place": "75 cm² culture flask", "amount": "8mL"},
        {"action": "put_into_incubator", "object": "75 cm² culture flask"},
        {"action": "set_incubator", "CO2": "5%", "temp": "37℃"},
        {"action": "start_device", "device": "incubator"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "time": "20min", "device": "incubator"},
        {"type": "resource_ready", "prepare": "complete culture medium, cell suspension"}
      ],
      "subtasks": [
        {"action": "take_out_incubator", "object": "75 cm² culture flask"},
        {"action": "discard_medium", "object": "75 cm² culture flask"},
        {"action": "aspirate", "object": "complete culture medium", "amount": "2mL"},
        {"action": "dispense", "place": "75 cm² culture flask", "amount": "2mL"},
        {"action": "aspirate", "object": "cell suspension", "amount": "4mL"},
        {"action": "dispense", "place": "75 cm² culture flask", "amount": "4mL"},
        {"action": "aspirate", "object": "complete culture medium", "amount": "6mL"},
        {"action": "dispense", "place": "75 cm² culture flask", "amount": "6mL"},
        {"action": "put_into_incubator", "object": "75 cm² culture flask"},
        {"action": "set_incubator", "CO2": "5%", "temp": "37℃"},
        {"action": "start_device", "device": "incubator"}
      ]
    }
  ]
}