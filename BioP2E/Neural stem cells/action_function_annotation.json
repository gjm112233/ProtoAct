{
  "stages": [
    {
      "monitor": [
        {"type": "resource_ready", "prepare": "fetal rat brain tissue, sterile 90 mm culture dish, D-Hanks solution"}
      ],
      "subtasks": [
        {"action": "transfer", "object": "fetal rat brain tissue", "source": "workspace","target": "90 mm culture dish"},
        {"action": "aspirate", "object": "D-Hanks solution", "amount": "10mL"},
        {"action": "dispense", "place": "90 mm culture dish", "amount": "10mL"},
        {"action": "shake", "object": "culture dish"},
        {"action": "discard_medium", "object": "90 mm culture dish"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "D-Hanks solution in 90 mm culture dish removed"},
        {"type": "resource_ready", "prepare": "surgical tools"}
      ],
      "subtasks": [
        {"action": "cut_in_piece", "target": "fetal rat brain tissue in 90 mm culture dish", "volume": "1mm³"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "time": "fetal rat brain tissue have been cut into 1mm³ fragments"},
        {"type": "resource_ready", "prepare": "centrifuge tube, DMEM/F12 conditioned medium"}
      ],
      "subtasks": [
        {"action": "transfer", "object": "brain tissue fragments", "source": "90 mm culture dish", "target": "centrifuge tube"},
        {"action": "aspirate", "object": "DMEM/F12 conditioned medium", "amount": "6mL"},
        {"action": "dispense", "place": "centrifuge tube", "amount": "6mL"},
        {"action": "resuspension", "object": "centrifuge tube"}
      ]
    },

    {
      "monitor": [
        {"type": "resource_ready", "prepare": "200-mesh nylon screen, new centrifuge tube"}
      ],
      "subtasks": [
        {"action": "filter_cell_suspension", "source": "original centrifuge tube", "filter_tool": "200-mesh nylon screen", "target": "new centrifuge tube"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "cell suspension from original centrifuge tube filtered"},
        {"type": "resource_ready", "prepare": "DMEM/F12 conditioned medium"}
      ],
      "subtasks": [
        {"action": "aspirate", "object": "DMEM/F12 conditioned medium", "amount": "2mL"},
        {"action": "dispense", "place": "the inner surface of the 200-mesh nylon screen", "amount": "2mL"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "all filtrate collected in centrifuge tube"},
        {"type": "resource_ready", "prepare": "trypan blue solution, hemocytometer, empty tube"}
      ],
      "subtasks": [
        {"action": "count_cells_trypan_blue", "source": "centrifuge tube"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "cell counting results have been obtained, the required volume of medium to be added (V mL) has been calculated based on the target density"},
        {"type": "resource_ready", "prepare": "DMEM/F12 conditioned medium, 90 mm culture dish"}
      ],
      "subtasks": [
        {"action": "cell_dilution", "target": "centrifuge tube", "diluent": "DMEM/F12 conditioned medium", "density": "1×10^6 cell/mL"},
        {"action": "cell_seed", "source": "centrifuge tube", "plate": "90 mm culture dish", "volume": "2mL"},
        {"action": "put_into_incubator", "object": "90 mm culture dish"},
        {"action": "set_incubator", "CO2": "5%", "temp": "37℃"},
        {"action": "start_device", "device": "incubator"}
      ]
    }
  ]
}