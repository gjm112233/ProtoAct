{
  "stages": [
    {
      "monitor": [
        {"type": "resource_ready", "prepare": "minced rat adipose tissue (4g), Erlenmeyer flask, 0.1% type I collagenase solution"}
      ],
      "subtasks": [
        {"action": "pick_and_place", "object": "minced rat adipose tissue", "place": "Erlenmeyer flask"},
        {"action": "aspirate", "object": "0.1% type I collagenase solution", "amount": "4mL"},
        {"action": "dispense", "place": "Erlenmeyer flask", "amount": "4mL"},
        {"action": "put_into_device", "device": "shaking water bath", "object": "Erlenmeyer flask"},
        {"action": "set_device", "device": "shaking water bath", "temp": "37℃", "time": "1h"},
        {"action": "start_device", "device": "shaking water bath"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "time": "1h", "device": "shaking water bath"},
        {"type": "resource_ready", "prepare": "centrifuge tube"}
      ],
      "subtasks": [
        {"action": "take_out_device", "device": "shaking water bath", "object": "Erlenmeyer flask"},
        {"action": "transfer_liquid", "source": "Erlenmeyer flask", "target": "centrifuge tube"},
        {"action": "put_into_centrifuge", "object": "centrifuge tube"},
        {"action": "set_centrifuge", "speed": "1200r/min", "time": "5min"},
        {"action": "start_device", "device": "centrifuge"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "time": "5min", "device": "centrifuge"}
      ],
      "subtasks": [
        {"action": "take_out_centrifuge", "object": "centrifuge tube"},
        {"action": "discard_supernatant", "object": "centrifuge tube"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "supernatant removed"},
        {"type": "resource_ready", "prepare": "DMEM/F12 culture medium containing 10% FBS and 1% penicillin–streptomycin"}
      ],
      "subtasks": [
        {"action": "aspirate", "object": "DMEM/F12 culture medium containing 10% FBS and 1% penicillin–streptomycin", "amount": "2mL"},
        {"action": "dispense", "place": "centrifuge tube", "amount": "2mL"},
        {"action": "resuspension", "object": "centrifuge tube"}
      ]
    },

    {
      "monitor": [
        {"type": "resource_ready", "prepare": "200-mesh nylon screen, new centrifuge tube"}
      ],
      "subtasks": [
        {"action": "filter_cell_suspension", "source": "original centrifuge tube", "filter_tool": "200-mesh nylon screen", "target": "new centrifuge tube"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "cell suspension from original centrifuge tube filtered"},
        {"type": "resource_ready", "prepare": "DMEM/F12 culture medium containing 10% FBS and 1% penicillin–streptomycin"}
      ],
      "subtasks": [
        {"action": "aspirate", "object": "DMEM/F12 culture medium containing 10% FBS and 1% penicillin–streptomycin", "amount": "2mL"},
        {"action": "dispense", "place": "the inner surface of the 200-mesh nylon screen", "amount": "2mL"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "all filtrate collected in centrifuge tube"}
      ],
      "subtasks": [
        {"action": "put_into_centrifuge", "object": "centrifuge tube"},
        {"action": "set_centrifuge", "speed": "1000r/min", "time": "5min"},
        {"action": "start_device", "device": "centrifuge"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "time": "5min", "device": "centrifuge"}
      ],
      "subtasks": [
        {"action": "take_out_centrifuge", "object": "centrifuge tube"},
        {"action": "discard_supernatant", "object": "centrifuge tube"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "supernatant removed"},
        {"type": "resource_ready", "prepare": "PBS solution"}
      ],
      "subtasks": [
        {"action": "aspirate", "object": "PBS solution", "amount": "2mL"},
        {"action": "dispense", "place": "centrifuge tube", "amount": "2mL"},
        {"action": "resuspension", "object": "centrifuge tube"},
        {"action": "put_into_centrifuge", "object": "centrifuge tube"},
        {"action": "set_centrifuge", "speed": "1000r/min", "time": "5min"},
        {"action": "start_device", "device": "centrifuge"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "time": "5min", "device": "centrifuge"}
      ],
      "subtasks": [
        {"action": "take_out_centrifuge", "object": "centrifuge tube"},
        {"action": "discard_supernatant", "object": "centrifuge tube"}
      ]
    },

    {
      "monitor": [
        {"type": "visual_state", "observe": "supernatant removed"},
        {"type": "resource_ready", "prepare": "DMEM/F12 culture medium containing 10% FBS, 25cm² culture flask"}
      ],
      "subtasks": [
        {"action": "aspirate", "object": "DMEM/F12 culture medium containing 10% FBS", "amount": "2mL"},
        {"action": "dispense", "place": "centrifuge tube", "amount": "2mL"},
        {"action": "resuspension", "object": "centrifuge tube"},
        {"action": "cell_seed", "source": "centrifuge tube", "plate": "25cm² culture flask", "volume": "2mL"},
        {"action": "put_into_incubator", "object": "25cm² culture flask"},
        {"action": "set_incubator", "temp": "37℃", "CO2": "5%"},
        {"action": "start_device", "device": "incubator"}
      ]
    },

    {
      "monitor": [
        {"type": "wait_time", "time": "3d", "device": "incubator"},
        {"type": "resource_ready", "prepare": "DMEM/F12 culture medium containing 10% FBS"}
      ],
      "subtasks": [
        {"action": "take_out_incubator", "object": "25cm² culture flask"},
        {"action": "discard_medium", "object": "25cm² culture flask"},
        {"action": "aspirate", "object": "DMEM/F12 culture medium containing 10% FBS", "amount": "2mL"},
        {"action": "dispense", "place": "25cm² culture flask", "amount": "2mL"},
        {"action": "put_into_incubator", "object": "25cm² culture flask"},
        {"action": "set_incubator", "temp": "37℃", "CO2": "5%"},
        {"action": "start_device", "device": "incubator"}
      ]
    }
  ]
}