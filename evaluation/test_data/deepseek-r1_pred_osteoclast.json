{
  "stages": [
    {
      "monitor": [
        {
          "type": "resource_ready",
          "prepare": "sectioned chicken bone shaft, petri dish, PBS"
        }
      ],
      "subtasks": [
        {
          "action": "transfer",
          "object": "sectioned chicken bone shaft",
          "source": "workspace",
          "target": "petri dish"
        },
        {
          "action": "aspirate",
          "object": "PBS",
          "amount": "20mL"
        },
        {
          "action": "dispense",
          "place": "petri dish",
          "amount": "20mL"
        },
        {
          "action": "shake",
          "object": "petri dish"
        },
        {
          "action": "discard_medium",
          "object": "petri dish"
        },
        {
          "action": "repeat",
          "back": "aspirate",
          "count": "1"
        }
      ]
    },
    {
      "monitor": [
        {
          "type": "visual_state",
          "observe": "bone shaft washed 3 times"
        },
        {
          "type": "resource_ready",
          "prepare": "PBS"
        }
      ],
      "subtasks": [
        {
          "action": "aspirate",
          "object": "PBS",
          "amount": "50mL"
        },
        {
          "action": "dispense",
          "place": "petri dish",
          "amount": "50mL"
        },
        {
          "action": "put_into_device",
          "device": "shaking water bath",
          "object": "petri dish"
        },
        {
          "action": "set_device",
          "device": "shaking water bath",
          "temp": "37℃"
        },
        {
          "action": "start_device",
          "device": "shaking water bath"
        }
      ]
    },
    {
      "monitor": [
        {
          "type": "wait_time",
          "time": "30min",
          "device": "shaking water bath"
        }
      ],
      "subtasks": [
        {
          "action": "take_out_device",
          "device": "shaking water bath",
          "object": "petri dish"
        }
      ]
    },
    {
      "monitor": [
        {
          "type": "resource_ready",
          "prepare": "centrifuge tube"
        }
      ],
      "subtasks": [
        {
          "action": "transfer_liquid",
          "source": "petri dish",
          "target": "centrifuge tube"
        },
        {
          "action": "put_into_centrifuge",
          "object": "centrifuge tube"
        },
        {
          "action": "set_centrifuge",
          "force": "650g",
          "time": "10min"
        },
        {
          "action": "start_device",
          "device": "centrifuge"
        }
      ]
    },
    {
      "monitor": [
        {
          "type": "wait_time",
          "time": "10min",
          "device": "centrifuge"
        }
      ],
      "subtasks": [
        {
          "action": "take_out_centrifuge",
          "object": "centrifuge tube"
        },
        {
          "action": "discard_supernatant",
          "object": "centrifuge tube"
        }
      ]
    },
    {
      "monitor": [
        {
          "type": "visual_state",
          "observe": "supernatant removed"
        },
        {
          "type": "resource_ready",
          "prepare": "PBS"
        }
      ],
      "subtasks": [
        {
          "action": "aspirate",
          "object": "PBS",
          "amount": "5mL"
        },
        {
          "action": "dispense",
          "place": "centrifuge tube",
          "amount": "5mL"
        },
        {
          "action": "resuspension",
          "object": "centrifuge tube"
        }
      ]
    },
    {
      "monitor": [
        {
          "type": "visual_state",
          "observe": "precipitate resuspended"
        },
        {
          "type": "resource_ready",
          "prepare": "50 mL centrifuge tube"
        }
      ],
      "subtasks": [
        {
          "action": "transfer_liquid",
          "source": "centrifuge tube",
          "target": "50 mL centrifuge tube"
        },
        {
          "action": "put_into_centrifuge",
          "object": "50 mL centrifuge tube"
        },
        {
          "action": "set_centrifuge",
          "force": "650g",
          "time": "20min"
        },
        {
          "action": "start_device",
          "device": "centrifuge"
        }
      ]
    },
    {
      "monitor": [
        {
          "type": "wait_time",
          "time": "20min",
          "device": "centrifuge"
        }
      ],
      "subtasks": [
        {
          "action": "take_out_centrifuge",
          "object": "50 mL centrifuge tube"
        },
        {
          "action": "discard_supernatant",
          "object": "50 mL centrifuge tube"
        }
      ]
    },
    {
      "monitor": [
        {
          "type": "visual_state",
          "observe": "supernatant removed"
        },
        {
          "type": "resource_ready",
          "prepare": "PBS"
        }
      ],
      "subtasks": [
        {
          "action": "aspirate",
          "object": "PBS",
          "amount": "10mL"
        },
        {
          "action": "dispense",
          "place": "50 mL centrifuge tube",
          "amount": "10mL"
        },
        {
          "action": "shake",
          "object": "50 mL centrifuge tube"
        },
        {
          "action": "discard_medium",
          "object": "50 mL centrifuge tube"
        },
        {
          "action": "repeat",
          "back": "aspirate",
          "count": "1"
        }
      ]
    },
    {
      "monitor": [
        {
          "type": "visual_state",
          "observe": "washing 2 times completed"
        },
        {
          "type": "resource_ready",
          "prepare": "PBS"
        }
      ],
      "subtasks": [
        {
          "action": "aspirate",
          "object": "PBS",
          "amount": "20mL"
        },
        {
          "action": "dispense",
          "place": "50 mL centrifuge tube",
          "amount": "20mL"
        }
      ]
    },
    {
      "monitor": [
        {
          "type": "resource_ready",
          "prepare": "trypan blue solution, hemocytometer, empty tube"
        }
      ],
      "subtasks": [
        {
          "action": "count_cells_trypan_blue",
          "source": "50 mL centrifuge tube"
        }
      ]
    },
    {
      "monitor": [
        {
          "type": "visual_state",
          "observe": "cell counting results obtained, the required volume (V mL) calculated based on target density 1×10^6 cell/mL"
        },
        {
          "type": "resource_ready",
          "prepare": "MEM medium supplemented with 10% FBS"
        }
      ],
      "subtasks": [
        {
          "action": "cell_dilution",
          "target": "50 mL centrifuge tube",
          "diluent": "MEM medium supplemented with 10% FBS",
          "density": "1×10^6 cell/mL"
        },
        {
          "action": "cell_seed",
          "source": "50 mL centrifuge tube",
          "plate": "culture flask",
          "volume": "2mL"
        },
        {
          "action": "put_into_incubator",
          "object": "culture flask"
        },
        {
          "action": "set_incubator",
          "CO2": "5%",
          "temp": "37℃"
        },
        {
          "action": "start_device",
          "device": "incubator"
        }
      ]
    },
    {
      "monitor": [
        {
          "type": "wait_time",
          "time": "24h",
          "device": "incubator"
        }
      ],
      "subtasks": [
        {
          "action": "take_out_incubator",
          "object": "culture flask"
        },
        {
          "action": "discard_medium",
          "object": "culture flask"
        }
      ]
    },
    {
      "monitor": [
        {
          "type": "visual_state",
          "observe": "old medium removed"
        },
        {
          "type": "resource_ready",
          "prepare": "fresh MEM medium supplemented with 10% FBS"
        }
      ],
      "subtasks": [
        {
          "action": "aspirate",
          "object": "fresh MEM medium supplemented with 10% FBS",
          "amount": "2mL"
        },
        {
          "action": "dispense",
          "place": "culture flask",
          "amount": "2mL"
        },
        {
          "action": "put_into_incubator",
          "object": "culture flask"
        },
        {
          "action": "set_incubator",
          "CO2": "5%",
          "temp": "37℃"
        },
        {
          "action": "start_device",
          "device": "incubator"
        }
      ]
    }
  ]
}