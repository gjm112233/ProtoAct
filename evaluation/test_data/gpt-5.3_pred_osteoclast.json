{
  "stages": [
    {
      "monitor": [
        {"type": "resource_ready", "prepare": "sectioned chicken diaphysis, petri dish, PBS"}
      ],
      "subtasks": [
        {"action": "transfer", "object": "sectioned chicken diaphysis", "source": "workspace", "target": "petri dish"},
        {"action": "aspirate", "object": "PBS", "amount": "20mL"},
        {"action": "dispense", "place": "petri dish containing sectioned chicken diaphysis", "amount": "20mL"},
        {"action": "shake", "object": "petri dish"},
        {"action": "discard_medium", "object": "petri dish"},
        {"action": "repeat", "back": "aspirate", "count": "2"}
      ]
    },
    {
      "monitor": [
        {"type": "visual_state", "observe": "PBS in the petri dish removed"},
        {"type": "resource_ready", "prepare": "PBS"}
      ],
      "subtasks": [
        {"action": "aspirate", "object": "PBS", "amount": "50mL"},
        {"action": "dispense", "place": "petri dish containing sectioned chicken diaphysis", "amount": "50mL"},
        {"action": "put_into_device", "device": "shaking water bath", "object": "petri dish"},
        {"action": "set_device", "device": "shaking water bath", "temp": "37℃", "time": "30min"},
        {"action": "start_device", "device": "shaking water bath"}
      ]
    },
    {
      "monitor": [
        {"type": "wait_time", "time": "30min", "device": "shaking water bath"}
      ],
      "subtasks": [
        {"action": "take_out_device", "device": "shaking water bath", "object": "petri dish"},
        {"action": "resuspension", "object": "petri dish"}
      ]
    },
    {
      "monitor": [
        {"type": "visual_state", "observe": "cell suspension prepared"},
        {"type": "resource_ready", "prepare": "centrifuge tube"}
      ],
      "subtasks": [
        {"action": "transfer_liquid", "source": "petri dish", "target": "centrifuge tube"},
        {"action": "put_into_centrifuge", "object": "centrifuge tube"},
        {"action": "set_centrifuge", "force": "650g", "time": "10min"},
        {"action": "start_device", "device": "centrifuge"}
      ]
    },
    {
      "monitor": [
        {"type": "wait_time", "time": "10min", "device": "centrifuge"}
      ],
      "subtasks": [
        {"action": "take_out_centrifuge", "object": "centrifuge tube"},
        {"action": "discard_supernatant", "object": "centrifuge tube"}
      ]
    },
    {
      "monitor": [
        {"type": "visual_state", "observe": "supernatant removed"},
        {"type": "resource_ready", "prepare": "PBS, 50mL centrifuge tube"}
      ],
      "subtasks": [
        {"action": "aspirate", "object": "PBS", "amount": "5mL"},
        {"action": "dispense", "place": "centrifuge tube", "amount": "5mL"},
        {"action": "resuspension", "object": "centrifuge tube"},
        {"action": "transfer_liquid", "source": "centrifuge tube", "target": "50mL centrifuge tube"}
      ]
    },
    {
      "monitor": [
        {"type": "visual_state", "observe": "cell suspension transferred to 50mL centrifuge tube"}
      ],
      "subtasks": [
        {"action": "put_into_centrifuge", "object": "50mL centrifuge tube"},
        {"action": "set_centrifuge", "force": "650g", "time": "20min"},
        {"action": "start_device", "device": "centrifuge"}
      ]
    },
    {
      "monitor": [
        {"type": "wait_time", "time": "20min", "device": "centrifuge"}
      ],
      "subtasks": [
        {"action": "take_out_centrifuge", "object": "50mL centrifuge tube"},
        {"action": "discard_supernatant", "object": "50mL centrifuge tube"}
      ]
    },
    {
      "monitor": [
        {"type": "visual_state", "observe": "supernatant removed"},
        {"type": "resource_ready", "prepare": "PBS"}
      ],
      "subtasks": [
        {"action": "aspirate", "object": "PBS", "amount": "10mL"},
        {"action": "dispense", "place": "50mL centrifuge tube", "amount": "10mL"},
        {"action": "resuspension", "object": "50mL centrifuge tube"},
        {"action": "put_into_centrifuge", "object": "50mL centrifuge tube"},
        {"action": "set_centrifuge", "force": "650g", "time": "10min"},
        {"action": "start_device", "device": "centrifuge"},
        {"action": "repeat", "back": "aspirate", "count": "1"}
      ]
    },
    {
      "monitor": [
        {"type": "wait_time", "time": "10min", "device": "centrifuge"}
      ],
      "subtasks": [
        {"action": "take_out_centrifuge", "object": "50mL centrifuge tube"},
        {"action": "discard_supernatant", "object": "50mL centrifuge tube"}
      ]
    },
    {
      "monitor": [
        {"type": "visual_state", "observe": "supernatant removed"},
        {"type": "resource_ready", "prepare": "PBS"}
      ],
      "subtasks": [
        {"action": "aspirate", "object": "PBS", "amount": "20mL"},
        {"action": "dispense", "place": "50mL centrifuge tube", "amount": "20mL"}
      ]
    },
    {
      "monitor": [
        {"type": "resource_ready", "prepare": "trypan blue solution, hemocytometer, empty tube"}
      ],
      "subtasks": [
        {"action": "count_cells_trypan_blue", "source": "50mL centrifuge tube"}
      ]
    },
    {
      "monitor": [
        {"type": "visual_state", "observe": "cell counting results have been obtained, the required volume of medium to be added (V mL) has been calculated based on the target density"},
        {"type": "resource_ready", "prepare": "MEM medium supplemented with 10% fetal bovine serum, culture flask"}
      ],
      "subtasks": [
        {"action": "cell_dilution", "target": "50mL centrifuge tube", "diluent": "MEM medium supplemented with 10% fetal bovine serum", "density": "1×10^6 cell/mL"},
        {"action": "cell_seed", "source": "50mL centrifuge tube", "plate": "culture flask", "volume": "2mL"},
        {"action": "put_into_incubator", "object": "culture flask"},
        {"action": "set_incubator", "CO2": "5%", "temp": "37℃"},
        {"action": "start_device", "device": "incubator"}
      ]
    },
    {
      "monitor": [
        {"type": "wait_time", "time": "24h", "device": "incubator"},
        {"type": "resource_ready", "prepare": "MEM medium supplemented with 10% fetal bovine serum"}
      ],
      "subtasks": [
        {"action": "take_out_incubator", "object": "culture flask"},
        {"action": "discard_medium", "object": "culture flask"},
        {"action": "aspirate", "object": "MEM medium supplemented with 10% fetal bovine serum", "amount": "2mL"},
        {"action": "dispense", "place": "culture flask", "amount": "2mL"},
        {"action": "put_into_incubator", "object": "culture flask"},
        {"action": "set_incubator", "CO2": "5%", "temp": "37℃"},
        {"action": "start_device", "device": "incubator"}
      ]
    }
  ]
}